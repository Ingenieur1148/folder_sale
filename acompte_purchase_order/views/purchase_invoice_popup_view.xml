<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view du wizard -->
    <record id="view_purchase_advance_payment_inv_form" model="ir.ui.view">
        <field name="name">purchase.advance.payment.inv.form</field>
        <field name="model">purchase.advance.payment.inv</field>
        <field name="arch" type="xml">
            <form string="Créer une facture fournisseur">
                <group>
                    <field name="purchase_id"/>
                    <field name="advance_payment_method" widget="radio"/>
                    <field name="advance_percent" invisible="advance_payment_method != 'advance_percent'"
                           />
                    <field name="advance_fixed" invisible="advance_payment_method !='advance_fixed'"
                          />
                </group>
                <footer>
                    <button string="Créer" type="object" name="create_invoices" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard (utile pour bouton) -->
    <record id="action_purchase_advance_payment_inv" model="ir.actions.act_window">
        <field name="name">Créer facture fournisseur (acompte)</field>
        <field name="res_model">purchase.advance.payment.inv</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
