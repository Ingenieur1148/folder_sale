<odoo>
    <record id="view_picking_form_inherit_delete" model="ir.ui.view">
        <field name="name">stock.picking.form.delete.done</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_force_delete"
                        string="Force Delete"
                        type="object"
                        class="btn-danger" invisible="state != 'done'"
            />
            </xpath>
        </field>
    </record>
</odoo>